{
  "name": "@thoth/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types, zod schemas, CVSS and report rendering",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --emitDeclarationOnly && node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "handlebars": "^4.7.8",
    "markdown-it": "^14.1.0",
    "sanitize-html": "^2.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.9.0",
    "@types/sanitize-html": "^2.13.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.6.3",
    "vitest": "^2.1.4"
  },
  "license": "MIT"
}
