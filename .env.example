# ==============================================================================
# THOTH — configuration
#
# RECOMMENDED: run ./install.sh — the interactive wizard asks everything,
# generates the secrets and writes a complete .env with chmod 600 (gitignored).
#
# MANUAL ALTERNATIVE: copy this file to .env (NON-sensitive configuration only)
# and export the SECRETS in your shell environment before bringing the stack up:
#   source deploy/gen-secrets.sh
# For Google sign-in, also export GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET.
# Never commit a .env containing secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# SECRETS — export them in your shell (or use the .env generated by ./install.sh),
# do NOT put them in this example file:
#   export SESSION_SECRET=$(openssl rand -base64 48)   # required
#   export ENCRYPTION_KEY=$(openssl rand -base64 32)   # required (32 bytes) — ALWAYS reuse the same one
#   export POSTGRES_PASSWORD=$(openssl rand -hex 24)   # required
#   export GOOGLE_CLIENT_ID=...                        # Google sign-in
#   export GOOGLE_CLIENT_SECRET=...                    # Google sign-in
#   export ANTHROPIC_API_KEY=...                       # AI assistant (if AI_PROVIDER=anthropic)
#   export LOCAL_ADMIN_INITIAL_PASSWORD=...            # optional (otherwise create-admin generates one)
# Compose refuses to start (with a clear message) if a required secret is missing.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# NON-sensitive configuration (safe to keep in this file)
# ------------------------------------------------------------------------------

# Public URL (cookies, OIDC redirect, WebAuthn). Secure cookies/HSTS when https.
# Dev: http://localhost:8080 | Production: https://YOUR-DOMAIN
BASE_URL=http://localhost:8080

# HTTP port published by the proxy on the host (dev)
HTTP_PORT=8080

# OIDC redirect path. The URI registered in Google is ${BASE_URL}${OIDC_REDIRECT_PATH}.
# Default: /api/auth/callback/google. If your OAuth Client uses a different path
# (e.g. /oauth2/callback), adjust it here — the Caddy proxy forwards /oauth2/callback
# to the internal handler automatically.
OIDC_REDIRECT_PATH=/api/auth/callback/google

# Number of trusted proxies in front of the API (local Caddy = 1; behind a
# load balancer/API gateway, confirm the hop count). Affects req.ip and Secure cookies.
TRUST_PROXY_HOPS=1

# --- AI assistant (optional) ---
# AI_PROVIDER selects the LLM provider: anthropic | ollama. Empty = the chat and
# "Generate Executive Summary" are disabled (the application works normally).
AI_PROVIDER=
# Model for the chosen provider. E.g.: claude-opus-5 (anthropic) | llama3.1 (ollama)
AI_MODEL=
# anthropic: the key (ANTHROPIC_API_KEY) is sensitive — export it in your shell:
#   export ANTHROPIC_API_KEY=...
# ollama: instance URL. Inside docker compose, the host's Ollama is reachable at
# http://host.docker.internal:11434 (compose default).
OLLAMA_BASE_URL=

# Run migrations on API boot (local dev = true). With multiple replicas, prefer
# false and run `prisma migrate deploy` as a separate step before the rollout.
MIGRATE_ON_BOOT=true

# Email domains allowed for Google sign-in (comma-separated)
ALLOWED_EMAIL_DOMAINS=example.com

# Emails automatically granted admin (comma-separated)
ADMIN_EMAILS=

# Default role for new Google users: VIEWER | AUTHOR
DEFAULT_USER_ROLE=VIEWER

# --- Google Workspace group restriction (optional) ---
# If set, ONLY members of these groups can sign in via Google (in addition to the domain).
# Requires a service account with the Directory API + domain-wide delegation.
# Empty = no group restriction. E.g.: security-group@example.com
GOOGLE_ALLOWED_GROUPS=
# Service account JSON (raw or base64-encoded). Delegated scope:
# https://www.googleapis.com/auth/admin.directory.group.member.readonly
GOOGLE_WORKSPACE_SA_JSON=
# Email of a Workspace admin the service account impersonates (delegation).
GOOGLE_WORKSPACE_ADMIN_SUBJECT=

# Local break-glass admin (/auth/local route, requires MFA). If you disable it,
# Google OIDC must be configured (the API refuses to start with no login method).
LOCAL_ADMIN_ENABLED=true

# Session lifetime in hours (rolling)
SESSION_TTL_HOURS=8

# Environment: development | production (affects logs; Secure cookies follow BASE_URL)
NODE_ENV=development

# Postgres (the password comes from the shell — POSTGRES_PASSWORD)
POSTGRES_USER=thoth
POSTGRES_DB=thoth

# Internal API port
PORT=3000

# Production (deploy/docker-compose.prod.yml): domain for Caddy's automatic TLS
THOTH_DOMAIN=
ACME_EMAIL=

# Demo data seed (1 = creates a sample project)
SEED_DEMO=0

# ------------------------------------------------------------------------------
# Outside Docker (running api/worker directly), also export in your shell:
#   export DATABASE_URL=postgresql://thoth:$POSTGRES_PASSWORD@localhost:5432/thoth
#   export REDIS_URL=redis://localhost:6379
# Inside docker compose, DATABASE_URL/REDIS_URL are assembled automatically.
# ------------------------------------------------------------------------------
