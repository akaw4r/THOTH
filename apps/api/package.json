{
  "name": "@thoth/api",
  "version": "0.1.0",
  "private": true,
  "description": "THOTH API (NestJS)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand --forceExit",
    "create-admin": "tsx src/cli/create-admin.ts",
    "seed": "tsx src/cli/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx src/cli/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@nestjs/common": "^10.4.7",
    "@nestjs/core": "^10.4.7",
    "@nestjs/platform-express": "^10.4.7",
    "@nestjs/throttler": "^6.2.1",
    "@prisma/client": "^6.8.2",
    "@simplewebauthn/server": "^13.1.1",
    "@thoth/shared": "*",
    "argon2": "^0.41.1",
    "bullmq": "^5.28.1",
    "connect-redis": "^7.1.1",
    "express-session": "^1.18.1",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "openid-client": "^5.7.0",
    "otplib": "^12.0.1",
    "prisma": "^6.8.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.7",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^11.2.1",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "jest-mock-extended": "^3.0.7",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^@thoth/shared$": "<rootDir>/../../../packages/shared/src/index.ts",
      "^@thoth/shared/node$": "<rootDir>/../../../packages/shared/src/node/index.ts",
      "^sanitize-html$": "<rootDir>/../test/stubs/sanitize-html.js"
    },
    "testEnvironment": "node"
  },
  "license": "MIT"
}
